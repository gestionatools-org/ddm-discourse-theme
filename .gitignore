node_modules
.discourse-site
.eslintcache

# Local-only Claude context and credentials
CLAUDE.local.md

# Environment files. THIS REPOSITORY IS PUBLIC and Discourse pulls it directly,
# so anything committed here is published twice over. Never track a .env.
.env
.env.*
!.env.example

# Upstream theme corpus cloned for reference (see CLAUDE.md)
.reference/

# Agent scratch: ledgers, task briefs, reports and review diffs
.superpowers/

# macOS
.DS_Store

# Playwright MCP scratch (screenshots can capture on-screen secrets)
.playwright-mcp/

# Prior-state captures: rollback artefacts, not source. They hold every topic title,
# author username and arrival announcement of a login-required community — personal data
# of identified public-sector employees — so they stay on disk and out of a public repo.
docs/superpowers/plans/data/*-prior-state.json
docs/superpowers/plans/data/*-move-proposals.json
docs/superpowers/plans/data/*-capture.json
docs/superpowers/plans/data/*-title-proposals.json

# Database dumps: member data, never in this public repo
backup/

