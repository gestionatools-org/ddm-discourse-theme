# Read-only Discourse credentials for local analysis. Copy to .env.local and
# fill in; .env.local is gitignored. This repository is PUBLIC — never commit
# a filled-in copy.
#
# Create the key at Admin -> API -> New API Key:
#   user   : an admin account (the restricted categories are invisible otherwise)
#   scope  : granular — categories:list + topics:read_lists
# Revoke it once the analysis it was created for is finished.
DISCOURSE_API_KEY=
DISCOURSE_API_USERNAME=
DISCOURSE_URL=https://discourse.gestiona4dev.tech
