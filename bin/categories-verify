#!/usr/bin/env python3
"""Assert the genre-reorganisation target state on PRE. Exit 0 only if it all holds.

Written before any change, so it is expected to FAIL until the plan is executed — which is
how the third room was added on 2026-09-11 too: the two new assertions were watched failing
first, then the room and its group were created. Re-run it after any category work.

Two blind spots, stated rather than hidden:

- It reads with the Global key, and /c/<id>/show.json answers with that user's own
  permissions. It can assert which group_permissions rows exist; it cannot assert what a
  member actually sees. That half is checked by signing in — see the plan's last task.
- Group membership is compared by name, so a room walled to the wrong group passes if the
  mapping below names that wrong group. The mapping is both the intent and the oracle.
"""
import json
import pathlib
import re
import sys
import unicodedata

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _discourse as d  # noqa: E402

ROOT = pathlib.Path(__file__).resolve().parent.parent
DATA = ROOT / "docs/superpowers/plans/data"
PRIOR = DATA / "2026-09-11-prior-state.json"
DECISIONS = DATA / "2026-09-11-move-decisions.json"
ROOMS = DATA / "2026-09-11-rooms.json"

# Must stay byte-identical to bin/categories-propose's CEREMONIAL: the two decide the
# same question from opposite ends, and a divergence would let this pass on a plaza the
# proposer would have emptied.
CEREMONIAL = re.compile(
    r"nuev[oa]s?\s+(?:\w+\s+){0,2}(alumn|compañer|miembr|certificad)"
    r"|certificad[oa]s?\s*[·\-:]"
    r"|enhorabuena|bienvenid",
    re.I,
)

CONVERSATIONAL = (4, 5, 14, 18)
UNTOUCHED = ("73", "75", "85", "59", "78", "3")
# Each room and the groups that must hold permission 1 on it. One row per programme
# group; `AdminDevelopers` is redundant today — all 3 of its members are already inside
# the cohort union — and is asserted anyway, because the team is not the student body and
# a future programme manager who never took a promotion would otherwise be locked out.
ROOM_GROUPS = {
    "administracion_avanzada": ("Certificación",),
    "analitica": ("Analiza",),
    "developers": ("Developers", "AdminDevelopers"),
}

# `Developers` is a derived group: its membership is exactly the union of the four cohort
# groups, which is why it is not self-service (no public admission, exit or requests) and
# why this is an invariant rather than a one-off capture. Measured 2026-09-11: the union is
# 49 people, not the 62 the raw sum suggests — 13 repeat a promotion.
DEVELOPER_COHORTS = ("Developers01", "Developers02", "Developers03", "Developers04")

# Since 2026-09-11 the three rooms are subcategories of the certificate's forum. Core
# refuses a child whose groups are absent from its parent (at any level), so the
# programme groups hold read-only there; and the forum's own listing shows only its
# announcements, not the rooms' topics.
# Deliberate changes made after the prior-state capture, each confirmed by Ricardo. The
# capture stays the oracle for everything else; these replace only the fields named.
# 2026-09-11 17:30-17:34 UTC, in admin: 73's tree opened to `Analiza` at full access and
# closed to `AdminAnaliza`, `AdminDevelopers` and `administradores` — which also fixes
# the fault recorded that morning, `Analiza` holding only read on its own resources —
# and 83 moved under 85. Found because the red step of the header-rooms work flagged
# 73 as drifted; the staff action log showed the edits, and he confirmed them.
ACCEPTED_SINCE_CAPTURE = {"73": {"permissions": {"Analiza": 1}}}

# The resource tree as it stands after those edits: child -> (parent, permissions).
# Nothing asserted the children before, which is why only the parent's drift showed.
RESOURCE_TREE = {
    79: (73, {"Analiza": 1}),
    80: (73, {"Analiza": 1}),
    81: (73, {"Analiza": 1}),
    82: (73, {"Analiza": 1}),
    84: (73, {"Analiza": 1}),
    88: (73, {"Analiza": 1}),
    83: (85, {"administradores": 1}),
}

FORUM = 5
FORUM_READERS = ("Analiza", "Developers", "AdminDevelopers")

failures = []


def check(condition, message):
    if not condition:
        failures.append(message)


def load(path):
    return json.loads(path.read_text()) if path.exists() else None


def crawl_ids(cid):
    """Topic ids in a category, minus its own definition topic — which is in the listing
    but not in topic_count, and which no rule should ever treat as content."""
    definition = d.definition_topic_id(cid)
    return {tid for tid in d.crawl_category(cid) if tid != definition}


def prior_ids(prior, cid):
    return {
        int(tid)
        for tid, t in prior["topics"].items()
        if t["category_id"] == cid and int(tid) != prior["categories"][str(cid)]["definition_topic_id"]
    }


def main():
    prior = load(PRIOR)
    decisions = load(DECISIONS)
    rooms = load(ROOMS)
    check(prior is not None, "prior-state capture missing")
    check(decisions is not None, "move decisions missing")
    check(rooms is not None, "rooms file missing — no room has been created")

    if prior and decisions:
        out5 = set(decisions["to_aa_room_from_5"])
        out4 = set(decisions["to_aa_room_from_4"]) | set(decisions["to_plaza"])
        news = set(decisions["to_news"])
        # The 28 analytics topics left whatever category they were in, afterwards and on a
        # separate decision — 11 from the plaza, 5 from ideas, 4 from news, 2 from room 89.
        # Subtracting the whole list from every expectation is exact: an id that was not in
        # a given set takes nothing out of it.
        analitica = set(decisions["to_analitica_room"])
        # Counts come from crawled sets, never from topic_count: the two differ by the
        # unlisted topics and the definition topic, and mixing them silently drifts.
        expected = {
            4: ((prior_ids(prior, 4) - out4) | news) - analitica,
            5: ((prior_ids(prior, 5) - out5) | set(decisions["to_plaza"])) - analitica,
            18: (prior_ids(prior, 18) - news) - analitica,
        }
        for cid, want in expected.items():
            got = crawl_ids(cid)
            check(
                got == want,
                f"category {cid}: {len(got)} topics, expected {len(want)}"
                f" (unexpected {sorted(got - want)[:8]}, missing {sorted(want - got)[:8]})",
            )

    if rooms and decisions:
        room_ids = (
            set(decisions["to_aa_room_from_4"]) | set(decisions["to_aa_room_from_5"])
        ) - analitica
        # `/t/2168` is the ONE of the 28 that did not move, and it cannot: it is category
        # 73's definition topic, and `Topic#changed_to_category` opens with
        # `return true if ... Category.exists?(topic_id: id)` — it reports success and
        # changes nothing, so `PUT /topics/bulk.json` listed it among the ids it changed
        # while it stayed in 73. Measured 2026-09-11. Excluded here rather than chased.
        #
        # The developers room is still born empty: that programme has not started posting.
        # An empty expectation is an assertion too — it catches a stray moved in by hand.
        expected_rooms = {
            "administracion_avanzada": room_ids,
            "analitica": analitica - {2168},
            "developers": set(),
        }
        for key, groups in ROOM_GROUPS.items():
            check(key in rooms, f"room {key} has not been created")
            if key not in rooms:
                continue
            cid = rooms[key]
            c = d.category(cid)
            perms = {
                g["group_name"]: g["permission_type"] for g in (c.get("group_permissions") or [])
            }
            check(c["read_restricted"], f"room {key} is not read_restricted — the wall did not apply")
            for group in groups:
                check(
                    perms.get(group) == 1,
                    f"room {key}: {group} should hold permission 1, has {perms}",
                )
            check(
                c.get("minimum_required_tags") == 0,
                f"room {key}: minimum_required_tags {c.get('minimum_required_tags')}, expected 0",
            )
            got = crawl_ids(cid)
            want = expected_rooms[key]
            check(
                got == want,
                f"room {key}: {len(got)} topics, expected {len(want)}"
                f" (unexpected {sorted(got - want)[:8]}, missing {sorted(want - got)[:8]})",
            )

    # The tag toll is gone from every conversational category.
    for cid in CONVERSATIONAL:
        got = d.category(cid).get("minimum_required_tags")
        check(got == 0, f"category {cid}: minimum_required_tags {got}, expected 0")

    # Category 5's topic_template was inherited from the dissolved "Proyectos piloto".
    check(
        not (d.category(5).get("topic_template") or "").strip(),
        "category 5 still has a topic_template",
    )

    # auto_close is deferred by decision: it must still be exactly where it was.
    for cid in CONVERSATIONAL:
        got = d.category(cid).get("auto_close_hours")
        check(got == 720.0, f"category {cid}: auto_close_hours {got}, expected 720.0 (deferred)")

    # Out-of-scope categories must be exactly as captured, settings and permissions.
    if prior:
        for cid in UNTOUCHED:
            c = d.category(int(cid))
            was = {**prior["categories"][cid], **ACCEPTED_SINCE_CAPTURE.get(cid, {})}
            perms = {
                g["group_name"]: g["permission_type"] for g in (c.get("group_permissions") or [])
            }
            check(c["name"] == was["name"], f"category {cid} was renamed (out of scope)")
            check(perms == was["permissions"], f"category {cid} permissions changed (out of scope)")
            check(
                c.get("minimum_required_tags") == was["minimum_required_tags"],
                f"category {cid} minimum_required_tags changed (out of scope)",
            )

    # A new category must not shadow a tag or a tag group on the `#` filter.
    #
    # Discourse resolves `#foo` as category slug -> exact tag name -> tag group slug, so a
    # category wins and the filter silently returns a different, plausible set. Creating
    # these two rooms did exactly that on 2026-09-11: `#administracion-avanzada` stopped
    # reaching the 700-topic tag and returned category 89's 241, and `#analitica-de-datos`
    # stopped reaching the subject-layer group and returned a single definition topic.
    # Both were fixed by giving the rooms a `foro-` slug; this keeps them fixed.
    #
    # bin/tags-verify checks the same collision but only for the eight module groups, so a
    # tag shadowed by a category passes there. Category 59 already shadows the tag
    # `eventos` and has for its whole life — a known, accepted, pre-existing condition —
    # which is why this asserts only the categories this work created.
    if rooms:
        def slugify(text):
            text = unicodedata.normalize("NFKD", text.lower())
            text = "".join(c for c in text if not unicodedata.combining(c))
            return re.sub(r"[^a-z0-9]+", "-", text).strip("-")

        taken = {slugify(t["name"]) for t in d.get("/tags.json", elevated=True)["tags"]}
        taken |= {slugify(g["name"]) for g in d.get("/tag_groups.json", elevated=True)["tag_groups"]}
        for key in ROOM_GROUPS:
            if key not in rooms:
                continue
            room_slug = d.category(rooms[key])["slug"]
            check(
                room_slug not in taken,
                f"room {key} slug #{room_slug} shadows a tag or tag group on the # filter",
            )

    for cid, (parent, want) in RESOURCE_TREE.items():
        c = d.category(cid)
        perms = {g["group_name"]: g["permission_type"] for g in (c.get("group_permissions") or [])}
        check(
            c.get("parent_category_id") == parent,
            f"category {cid}: parent {c.get('parent_category_id')}, expected {parent}",
        )
        check(perms == want, f"category {cid}: permissions {perms}, expected {want}")

    if rooms:
        for key in ROOM_GROUPS:
            if key in rooms:
                parent = d.category(rooms[key]).get("parent_category_id")
                check(parent == FORUM, f"room {key}: parent {parent}, expected {FORUM}")
    forum = d.category(FORUM)
    check(
        forum.get("default_list_filter") == "none",
        f"category {FORUM}: default_list_filter {forum.get('default_list_filter')!r},"
        f" expected 'none' — the plaza would list every room's topics",
    )
    forum_perms = {
        g["group_name"]: g["permission_type"] for g in (forum.get("group_permissions") or [])
    }
    for group in FORUM_READERS:
        check(
            forum_perms.get(group) == 3,
            f"category {FORUM}: {group} holds {forum_perms.get(group)}, expected 3 (read-only)",
        )

    # `Developers` must be exactly the union of the four cohorts, and must not be
    # self-service — a member who could leave it would silently lose the room while still
    # being in a cohort, which is the drift this group exists to prevent.
    union = set()
    for cohort in DEVELOPER_COHORTS:
        union |= set(d.group_members(cohort))
    developers = d.group("Developers")
    check(developers is not None, "group Developers does not exist")
    if developers:
        have = set(d.group_members("Developers"))
        check(
            have == union,
            f"group Developers has {len(have)} members, expected the cohort union of"
            f" {len(union)} (extra {len(have - union)}, missing {len(union - have)})",
        )
        for field in ("public_admission", "public_exit", "allow_membership_requests"):
            check(not developers.get(field), f"group Developers: {field} is on, expected off")
        check(
            not developers.get("primary_group"),
            "group Developers is a primary group — it would overwrite the flair of all"
            " 49 members, every one of whom is already in Certificación",
        )

    # Nothing but arrival announcements and the approved exceptions may remain in the plaza.
    if decisions:
        allowed = set(decisions["stays_in_plaza"]) | set(decisions["to_plaza"])
        strays = sorted(
            t["id"]
            for tid, t in d.crawl_category(5).items()
            if tid != d.definition_topic_id(5)
            and "poster-evf" not in d.tag_names(t)
            and not CEREMONIAL.search(t["title"])
            and tid not in allowed
        )
        check(not strays, f"unapproved non-ceremonial topics left in the plaza: {strays}")

    if failures:
        print("FAIL")
        for f in failures:
            print("  -", f)
        sys.exit(1)
    print("OK: genre reorganisation target state holds")


if __name__ == "__main__":
    main()
