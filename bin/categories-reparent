#!/usr/bin/env python3
"""Move one category under another (or to the top level with parent 0).

Usage: bin/categories-reparent <category-id> <parent-id|0>

Reparenting is one of the three things that does NOT issue or retire a category id —
rename and slug change are the others — so it is safe for every ID-keyed theme setting.
It does not move topics either.

`PUT /categories/<id>.json` replaces the record, so this reads the category first and
sends it back with only `parent_category_id` changed, permissions included. A field not
resent can revert to a default.

**Three levels need `max_category_nesting`, which is hidden.** Core's default is 2 (max 3),
and Discourse refuses to change a hidden setting through the admin API — so if the target
would be a grandparent, this fails and the fix is a request to Discourse Cloud, not a
retry. The failure is loud, which is why this script does not pre-check it.
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _discourse as d  # noqa: E402


def main(cid, parent):
    c = d.category(cid)
    was = c.get("parent_category_id")
    print(f"cat {cid} {c['name']!r}: parent {was} -> {parent or None}")

    payload = [
        ("name", c["name"]),
        ("slug", c["slug"]),
        ("color", c["color"]),
        ("text_color", c["text_color"]),
        ("parent_category_id", parent),
        ("auto_close_hours", c.get("auto_close_hours") or ""),
        ("auto_close_based_on_last_post", str(bool(c.get("auto_close_based_on_last_post"))).lower()),
        ("minimum_required_tags", c.get("minimum_required_tags") or 0),
        ("topic_template", c.get("topic_template") or ""),
        ("description", c.get("description_excerpt") or ""),
    ]
    for g in c.get("group_permissions") or []:
        payload.append((f"permissions[{g['group_name']}]", g["permission_type"]))

    d.request("PUT", f"/categories/{cid}.json", data=payload, elevated=True)

    after = d.category(cid)
    now = after.get("parent_category_id")
    perms = {g["group_name"]: g["permission_type"] for g in (after.get("group_permissions") or [])}
    print(f"  now: parent={now} slug={after['slug']!r} perms={perms}")
    if now != (parent or None):
        raise SystemExit(f"FAIL: parent is {now}, expected {parent or None}")
    print("OK")


if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    main(int(args[0]), int(args[1]))
