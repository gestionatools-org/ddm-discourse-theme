#!/usr/bin/env python3
"""Move one category under another (or to the top level with parent 0).

Usage: bin/categories-reparent <category-id> <parent-id|0>

Reparenting is one of the three things that does NOT issue or retire a category id —
rename and slug change are the others — so it is safe for every ID-keyed theme setting.
It does not move topics either.

The read-and-resend lives in `_discourse.update_category`. `description` is not resent —
an earlier version sent `description_excerpt` back, which would have overwritten a
definition topic with its own excerpt; it never ran against a category that has one.

**Three levels need `max_category_nesting`, which is hidden.** Core's default is 2 (max 3),
and Discourse refuses to change a hidden setting through the admin API — so if the target
would be a grandparent, this fails and the fix is a request to Discourse Cloud, not a
retry. The failure is loud, which is why this script does not pre-check it.
"""
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _discourse as d  # noqa: E402


def main(cid, parent):
    was = d.category(cid)
    target = parent or None
    print(f"cat {cid} {was['name']!r}: parent {was.get('parent_category_id')} -> {target}")
    if was.get("parent_category_id") == target:
        print("  already there")
        return
    after = d.update_category(cid, {"parent_category_id": parent or ""})
    perms = {g["group_name"]: g["permission_type"] for g in (after.get("group_permissions") or [])}
    print(f"  now: parent={after.get('parent_category_id')} slug={after['slug']!r} perms={perms}")
    if after.get("parent_category_id") != target:
        raise SystemExit(f"FAIL: parent is {after.get('parent_category_id')}, expected {target}")
    print("OK")


if __name__ == "__main__":
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    main(int(args[0]), int(args[1]))
