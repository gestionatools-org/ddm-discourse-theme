#!/usr/bin/env python3
"""Assert the subject-layer target state on PRE. Exit 0 only if it all holds."""
import json, pathlib, re, sys, unicodedata

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
import _discourse as d  # noqa: E402

ROOT = pathlib.Path(__file__).resolve().parent.parent
MAPS = {
    "PRE": "2026-09-04-module-axis.json",
    "PROD": "2026-09-13-prod-module-axis.json",
}
MAP = json.loads((ROOT / "docs/superpowers/plans/data" / MAPS[d._instance()]).read_text())

# The depuration left nothing below three uses; a tag under it is either a typo that
# invented an empty tag or a concept that stopped classifying anything. `analítica` became
# the second kind on 2026-09-11 — its 28 topics moved into category 90, which names the
# subject, so the tag classified nothing and was deleted with its synonym rather than
# exempted. That is why the module group "Analítica de datos" now has two members.
MIN_USES = 3
# Working queues are counted, not judged: their size is data about what is unclassified.
USE_EXEMPT = {"pendiente-etiquetar"}


def slug(s):
    """Approximate the slug Discourse's search parser computes for a `#term`."""
    s = unicodedata.normalize("NFKD", s.lower())
    s = "".join(c for c in s if not unicodedata.combining(c))
    return re.sub(r"[^a-z0-9]+", "-", s).strip("-")


def main():
    failures = []
    tags = {t["name"]: t for t in d.get("/tags.json", elevated=True)["tags"]}
    groups = {g["name"]: g for g in d.get("/tag_groups.json", elevated=True)["tag_groups"]}

    for name, want in MAP["groups"].items():
        got = groups.get(name)
        if not got:
            failures.append(f"group missing: {name}")
            continue
        have = sorted(t["name"] for t in got["tags"])
        if have != sorted(want):
            failures.append(
                f"group {name}: missing={sorted(set(want) - set(have))} extra={sorted(set(have) - set(want))}"
            )

    for name in MAP["delete"]:
        if name in tags:
            failures.append(f"still present, should be deleted: {name}")

    for old, new in MAP["rename"].items():
        if old in tags:
            failures.append(f"old name still a base tag, rename not done: {old}")
        if new not in tags:
            failures.append(f"renamed tag absent: {new}")
            continue
        info = d.get(f"/tag/{tags[new]['id']}/info.json", elevated=True).get("tag_info", {})
        syns = [s["name"] for s in info.get("synonyms", [])]
        if old not in syns:
            failures.append(f"{new} does not carry '{old}' as a synonym — #{old} no longer filters")

    # A tag below the floor is usually an empty one invented by a typo in a group's
    # tag_names[], which the membership check above cannot see: it compares names, and an
    # invented tag has the right name.
    for name, t in sorted(tags.items()):
        if name not in USE_EXEMPT and t["count"] < MIN_USES:
            failures.append(f"tag below {MIN_USES} uses: {name} ({t['count']})")

    # A group whose slug is also a tag's or a category's is shadowed: search resolves
    # `#foo` as category slug -> exact tag name -> tag-group slug, so the filter never
    # reaches the group and silently returns a subset. Slugifying the base tag name also
    # covers its unaccented synonym, which is the case that actually bit us. A synonym
    # whose string differs otherwise is not checked — that would cost one call per tag.
    cats, stack = [], list(
        d.get("/categories.json?include_subcategories=true", elevated=True)["category_list"]["categories"]
    )
    while stack:
        c = stack.pop()
        cats.append(c)
        stack.extend(c.get("subcategory_list") or [])
    shadows = {}
    for name in tags:
        shadows.setdefault(slug(name), []).append(f"tag {name}")
    for c in cats:
        shadows.setdefault(c["slug"], []).append(f"category {c['id']} {c['name']}")
    for name in MAP["groups"]:
        by = shadows.get(slug(name))
        if by:
            failures.append(f"group {name} is shadowed on #{slug(name)} by {', '.join(by)}")

    if failures:
        print(f"FAIL — {len(failures)} assertion(s)")
        for f in failures:
            print(f"  ✗ {f}")
        return 1
    print(
        f"PASS — {len(MAP['groups'])} groups, {len(MAP['delete'])} deletions, "
        f"{len(MAP['rename'])} renames, {len(tags)} tags at {MIN_USES}+ uses, no shadowed slug"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
